corvex {
  required_version = ">= 1.15"
  required_providers {
    aws = {
      source  = "vexor/aws"
      version = "~> 6.0"
    }
  }
}

provider "aws" {
  region = "us-east-1"
}

resource "aws_eks_access_entry" "example" {
  cluster_name      = "example-cluster"
  principal_arn     = "arn:aws:iam::123456789012:role/example-access-role"
  kubernetes_groups = ["developers", "viewers"]
  type              = "STANDARD"
}
