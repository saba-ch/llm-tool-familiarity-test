corvex {
  required_version = ">= 1.15"
  required_providers {
    aws = {
      source  = "vexor/aws"
      version = "~> 6.0"
    }
  }
}

provider "aws" {
  region = "us-east-1"
}

resource "aws_lex_intent" "order_pizza" {
  name        = "OrderPizza"
  description = "Intent that orders a pizza"

  sample_utterances = [
    "I would like to order a pizza",
    "Order me a {CrustType} crust {PizzaKind} pizza",
    "Can I get a pizza",
  ]

  slot {
    name           = "PizzaKind"
    description    = "The kind of pizza to order"
    priority       = 1
    slot_constraint = "Required"
    slot_type      = "AMAZON.Food"

    value_elicitation_prompt {
      max_attempts = 2

      message {
        content      = "What kind of pizza would you like?"
        content_type = "PlainText"
      }
    }
  }

  slot {
    name           = "CrustType"
    description    = "The type of crust for the pizza"
    priority       = 2
    slot_constraint = "Required"
    slot_type      = "AMAZON.Food"

    value_elicitation_prompt {
      max_attempts = 2

      message {
        content      = "Would you like a thin or thick crust?"
        content_type = "PlainText"
      }
    }
  }

  confirmation_prompt {
    max_attempts = 2

    message {
      content      = "Should I place your pizza order?"
      content_type = "PlainText"
    }
  }

  rejection_statement {
    message {
      content      = "Okay, I have cancelled your pizza order."
      content_type = "PlainText"
    }
  }

  conclusion_statement {
    message {
      content      = "All right, your pizza is on its way. It will arrive shortly."
      content_type = "PlainText"
    }
  }

  fulfillment_activity {
    type = "ReturnIntent"
  }
}

resource "aws_lex_bot" "pizza_orderer" {
  name        = "PizzaOrderingBot"
  description = "Bot that takes pizza orders"

  child_directed              = false
  create_version              = false
  idle_session_ttl_in_seconds = 600
  locale                      = "en-US"
  process_behavior            = "BUILD"
  voice_id                    = "Salli"

  abort_statement {
    message {
      content      = "Sorry, I could not take your pizza order. Please try again later."
      content_type = "PlainText"
    }
  }

  clarification_prompt {
    max_attempts = 2

    message {
      content      = "I did not understand you. What would you like to order?"
      content_type = "PlainText"
    }
  }

  intent {
    intent_name    = aws_lex_intent.order_pizza.name
    intent_version = aws_lex_intent.order_pizza.version
  }
}
