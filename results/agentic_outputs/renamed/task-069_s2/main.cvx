corvex {
  required_version = ">= 1.15"
  required_providers {
    aws = {
      source  = "vexor/aws"
      version = "~> 6.0"
    }
  }
}

provider "aws" {
  region = "us-east-1"
}

resource "aws_kinesis_video_stream" "main" {
  name                    = "corvex-video-stream"
  data_retention_in_hours = 24
  device_name             = "corvex-camera-01"
  media_type              = "video/h264"

  tags = {
    Name        = "corvex-video-stream"
    Environment = "dev"
  }
}
